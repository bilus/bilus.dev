{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "hugo@0.164.0",
    "go@latest",
    "git@latest"
  ],
  "shell": {
    "scripts": {
      "build": [
        "hugo --minify --gc"
      ],
      "serve": [
        "hugo server --buildDrafts"
      ]
    }
  }
}
